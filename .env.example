# SW-KA KartenService credentials (required)
SWKA_KARTE_NR=
SWKA_PASSWORD=

# ownCloud WebDAV upload of the finished workbook (optional)
# URL of your ownCloud instance WITHOUT trailing slash
SWKA_WEBDAV_URL=
SWKA_WEBDAV_USER=
SWKA_WEBDAV_PASSWORD=
# Remote path inside the user's ownCloud (folder is created automatically)
SWKA_WEBDAV_PATH=/StudentCardTracker/spendings.xlsx

# Scrape interval in seconds (default 3600 = hourly)
SWKA_INTERVAL_SECONDS=3600

# Optional overrides
# SWKA_LOOKBACK_DAYS=60
# SWKA_RECEIPTS_DOWNLOAD=true
