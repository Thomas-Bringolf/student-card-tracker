# SW-KA KartenService credentials (required)
SWKA_KARTE_NR=
SWKA_PASSWORD=

# ownCloud WebDAV upload of the finished workbook (optional)
# Either the instance root …
#   SWKA_WEBDAV_URL=https://cloud.example.com
#   SWKA_WEBDAV_USER=username
#   SWKA_WEBDAV_PASSWORD=
#   SWKA_WEBDAV_PATH=/Folder/spendings.xlsx
# … or a full DAV base already containing /dav/ (e.g. an ocis space URL):
#   SWKA_WEBDAV_URL=https://cloud.example.com/dav/spaces/<space-id>$<item-id>
#   SWKA_WEBDAV_PATH=/spendings.xlsx
SWKA_WEBDAV_URL=
SWKA_WEBDAV_USER=
SWKA_WEBDAV_PASSWORD=
SWKA_WEBDAV_PATH=/spendings.xlsx

# Scrape interval in seconds (default 3600 = hourly)
SWKA_INTERVAL_SECONDS=3600

# Optional overrides
# SWKA_LOOKBACK_DAYS=60
# SWKA_RECEIPTS_DOWNLOAD=true
